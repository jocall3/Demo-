# .env.example for the API Gateway

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# The URL of the frontend application for CORS policy.
# In development, this matches the Vite dev server.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# As per the Zero-Trust Secret Management directive, all secrets (API keys,
# client secrets, etc.) are fetched from Vault at startup. This service authenticates
# using the AppRole method.
#
# Address of the Vault server.
VAULT_ADDR=http://localhost:8200
# AppRole credentials for authenticating with Vault. In production, the SECRET_ID
# would be securely injected (e.g., via a CI/CD pipeline wrapper).
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Base path in Vault where this service's secrets are stored.
# The service will fetch keys like 'OIDC_CLIENT_SECRET' and 'SUBGRAPH_API_KEY' from this path.
VAULT_SECRETS_PATH=secret/data/api-gateway

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (OAuth 2.0 / OIDC)
# -----------------------------------------------------------------------------
# Configuration for the OpenID Connect (OIDC) compliant Identity Provider (e.g., Keycloak).
# The gateway validates incoming tokens and performs token exchange for downstream services.
#
# The URL of the OIDC provider's discovery endpoint.
OIDC_ISSUER_URL=http://localhost:8180/realms/demobank
# The 'audience' claim this gateway expects in incoming JWTs.
OIDC_AUDIENCE=api-gateway
# This gateway's client ID, used for the token exchange flow. The corresponding secret is fetched from Vault.
OIDC_CLIENT_ID=api-gateway-client

# NOTE: OIDC_CLIENT_SECRET is NOT stored here. It is fetched from Vault.
# NOTE: SUBGRAPH_API_KEY is NOT stored here. It is fetched from Vault.

# -----------------------------------------------------------------------------
# DISTRIBUTED CACHING (Redis)
# -----------------------------------------------------------------------------
# Connection details for the Redis cluster used for GraphQL query caching.
REDIS_HOST=localhost
REDIS_PORT=6379
# The Redis password should be fetched from Vault in production.

# -----------------------------------------------------------------------------
# WORKFLOW ORCHESTRATION (Temporal)
# -----------------------------------------------------------------------------
# Connection details for the Temporal cluster. The API gateway may act as a client
# to start or query business workflows (Sagas).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# -----------------------------------------------------------------------------
# APOLLO GATEWAY SUBGRAPH CONFIGURATION
# -----------------------------------------------------------------------------
# URLs for the GraphQL subgraphs that this gateway will compose.
# In a local Docker environment, these should point to the internal service names.
USERS_SERVICE_URL=http://localhost:4001/graphql
ACCOUNTS_SERVICE_URL=http://localhost:4002/graphql
TRANSACTIONS_SERVICE_URL=http://localhost:4003/graphql
AI_AGENT_SERVICE_URL=http://localhost:4004/graphql
PLAID_INTEGRATION_SERVICE_URL=http://localhost:4005/graphql

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=api-gateway
# The endpoint where the OpenTelemetry collector is running (HTTP/OTLP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Port for the Prometheus exporter to expose metrics for scraping.
PROMETHEUS_PORT=9464
