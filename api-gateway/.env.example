# .env.example for the API Gateway

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# The URL of the frontend application for CORS policy.
# This should match the URL your React/Vite development server is running on.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# A strong, random secret for signing JWTs for client sessions.
# The gateway is responsible for authenticating client requests.
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long

# A shared secret for authenticating requests from the gateway to subgraphs.
# Subgraphs should be configured to validate this key on incoming requests.
SUBGRAPH_API_KEY=your-subgraph-api-key

# -----------------------------------------------------------------------------
# APOLLO GATEWAY SUBGRAPH CONFIGURATION
# -----------------------------------------------------------------------------
# URLs for the GraphQL subgraphs that this gateway will compose.
# These should point to the running microservices. Add more as new
# services are created.
BANKING_SUBGRAPH_URL=http://localhost:4001/graphql
GENAI_SUBGRAPH_URL=http://localhost:4002/graphql

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=api-gateway

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP/HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
