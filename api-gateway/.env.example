# .env.example for the API Gateway

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# The URL of the frontend application for CORS policy.
# This should match the URL your React/Vite development server is running on.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (OAuth 2.0 / OIDC)
# -----------------------------------------------------------------------------
# Configuration for the OpenID Connect (OIDC) compliant Identity Provider (e.g., Keycloak, Auth0).
# The gateway will validate tokens issued by this authority.
OIDC_ISSUER_URL=https://your-identity-provider.com/auth/realms/your-realm
OIDC_AUDIENCE=api-gateway-audience # The audience value to validate in JWTs.
# The following are for service-to-service communication (e.g., token exchange)
# and should be managed via a secrets manager in production.
OIDC_CLIENT_ID=api-gateway-client
OIDC_CLIENT_SECRET=your-oidc-client-secret

# A shared secret for securing internal communication between the gateway and subgraphs.
# Subgraphs should be configured to validate this key on incoming requests.
# In production, this should be managed via a secrets manager.
SUBGRAPH_API_KEY=your-subgraph-api-key

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# Configuration for connecting to HashiCorp Vault to fetch secrets at runtime.
# Address of the Vault server.
VAULT_ADDR=http://localhost:8200
# AppRole credentials for authenticating with Vault.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Path in Vault where the service's secrets are stored.
VAULT_SECRET_PATH=secret/data/api-gateway

# -----------------------------------------------------------------------------
# APOLLO GATEWAY SUBGRAPH CONFIGURATION
# -----------------------------------------------------------------------------
# URLs for the GraphQL subgraphs that this gateway will compose.
# These should point to the running microservices.
USERS_SERVICE_URL=http://localhost:4001/graphql
ACCOUNTS_SERVICE_URL=http://localhost:4002/graphql
TRANSACTIONS_SERVICE_URL=http://localhost:4003/graphql
AI_AGENT_SERVICE_URL=http://localhost:4004/graphql
PLAID_INTEGRATION_SERVICE_URL=http://localhost:4005/graphql

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=api-gateway

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP/HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
