{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "The primary API Gateway for the Demo Bank federated supergraph. Responsible for composing subgraphs, request routing, caching, authentication, and orchestrating sagas via Temporal.",
  "author": "Elite AI Implementation Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
