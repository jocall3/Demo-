# .env for the API Gateway (formerly BFF)

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# The URL of the frontend application for CORS policy.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (OIDC / OAuth 2.0)
# -----------------------------------------------------------------------------
# Keycloak issuer URL for token validation.
OIDC_ISSUER_URL=http://localhost:8180/realms/demobank
# The audience ('aud' claim) this gateway expects in incoming JWTs.
OIDC_AUDIENCE=api-gateway
# Client ID for the gateway, used for service-to-service token exchange.
# The client secret is sourced from Vault, not stored here.
OIDC_CLIENT_ID=api-gateway

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# Address of the Vault server.
VAULT_ADDR=http://localhost:8200
# For local development, a root token is used for simplicity.
# In production, AppRole credentials would be injected securely.
VAULT_TOKEN=root
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# -----------------------------------------------------------------------------
# APOLLO GATEWAY SUBGRAPH CONFIGURATION
# -----------------------------------------------------------------------------
# URLs for the GraphQL subgraphs. These point to the respective microservices.
USERS_SERVICE_URL=http://localhost:4001/graphql
ACCOUNTS_SERVICE_URL=http://localhost:4002/graphql
TRANSACTIONS_SERVICE_URL=http://localhost:4003/graphql
AI_AGENT_SERVICE_URL=http://localhost:4004/graphql
PLAID_INTEGRATION_SERVICE_URL=http://localhost:4005/graphql

# -----------------------------------------------------------------------------
# WORKFLOW ORCHESTRATION (Temporal)
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# -----------------------------------------------------------------------------
# DISTRIBUTED CACHING (Redis)
# -----------------------------------------------------------------------------
# Host and port for the Redis cluster.
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical service name for this gateway.
OTEL_SERVICE_NAME=api-gateway
# The endpoint of the OpenTelemetry Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# The port this service will expose its Prometheus metrics on.
PROMETHEUS_PORT=9464
