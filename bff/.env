# .env for BFF service, now acting as an API Gateway

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# The URL of the frontend client, used for CORS configuration.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# A strong, random secret key for signing and verifying JSON Web Tokens.
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# API GATEWAY (APOLLO FEDERATION)
# -----------------------------------------------------------------------------
# URLs for the GraphQL subgraphs that this gateway will compose.
BANKING_SUBGRAPH_URL=http://localhost:4001/graphql
GENAI_SUBGRAPH_URL=http://localhost:4002/graphql
# Add other subgraph URLs here as they are created
# USERS_SUBGRAPH_URL=http://localhost:4003/graphql

# Optional: A shared secret for authenticating requests from the gateway to subgraphs.
# SUBGRAPH_API_KEY=your-subgraph-api-key

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=api-gateway

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=debug
