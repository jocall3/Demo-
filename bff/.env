# Server Configuration
PORT=3001

# JWT Secret for session management between frontend and BFF
JWT_SECRET="your-super-secret-jwt-key-that-is-at-least-32-characters-long"

# Database Connection
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL="postgresql://docker:docker@localhost:5432/demobank_bff?schema=public"

# Google Gemini API Key
GEMINI_API_KEY="your-google-gemini-api-key"

# Plaid API Keys
# Get from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret-for-sandbox-or-development"
# Plaid environment can be 'sandbox', 'development', or 'production'
PLAID_ENV="sandbox"

# Stripe API Keys
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLIC_KEY="pk_test_your_stripe_public_key"

# Add other service keys as needed (e.g., Marqeta, Modern Treasury)
# MARQETA_USERNAME="your_marqeta_username"
# MARQETA_PASSWORD="your_marqeta_password"
