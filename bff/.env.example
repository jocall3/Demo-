# .env.example for BFF service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# The URL of the frontend client, used for CORS configuration.
# The default Vite dev server runs on port 3000.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# A strong, random secret key for signing and verifying JSON Web Tokens.
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------

# Google Gemini API Key
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Plaid API Keys
# Get from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# Plaid environment can be 'sandbox', 'development', or 'production'
PLAID_ENV=sandbox

# Stripe API Keys
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Connection string for the database.
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL=

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=bff

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The protocol for the OTLP exporter ('grpc' or 'http/protobuf').
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Comma-separated list of exporters to use for traces. 'otlp' is standard.
OTEL_TRACES_EXPORTER=otlp

# Comma-separated list of exporters to use for metrics. 'otlp' and 'prometheus' are common.
OTEL_METRICS_EXPORTER=otlp

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=debug
