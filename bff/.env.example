# .env.example for the API Gateway (formerly BFF)
# This file provides a template for all required environment variables for the gateway.
# It has been updated to reflect the new architecture including OIDC Token Exchange,
# Vault for secrets, Temporal for workflows, and Redis for caching.

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS & CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
# The URL of the frontend application (or MFE shell) for CORS configuration.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (OIDC / OAUTH 2.0 TOKEN EXCHANGE)
# -----------------------------------------------------------------------------
# The issuer URL of the OpenID Connect provider (e.g., Keycloak). Used for validating incoming JWTs.
OIDC_ISSUER_URL=http://localhost:8180/realms/demobank
# The endpoint for the OAuth 2.0 Token Exchange grant type.
OIDC_TOKEN_ENDPOINT=http://localhost:8180/realms/demobank/protocol/openid-connect/token
# The 'audience' claim this gateway expects in incoming JWTs.
OIDC_AUDIENCE=api-gateway
# The client ID for this gateway, used to authenticate itself to the OIDC provider during token exchange.
OIDC_CLIENT_ID=api-gateway-client
# The client secret for this gateway. FOR DEVELOPMENT ONLY. In production, this must be fetched from Vault.
OIDC_CLIENT_SECRET=your-client-secret-for-development

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# The address of the Vault server.
VAULT_ADDR=http://localhost:8200
# The AppRole Role ID for this service to authenticate with Vault.
VAULT_ROLE_ID=
# The AppRole Secret ID for this service.
VAULT_SECRET_ID=
# The base path in Vault where this service's secrets are stored (e.g., OIDC_CLIENT_SECRET).
VAULT_SECRETS_PATH=secret/data/api-gateway

# -----------------------------------------------------------------------------
# WORKFLOW ORCHESTRATION (Temporal)
# -----------------------------------------------------------------------------
# The gRPC endpoint for the Temporal frontend service.
TEMPORAL_ADDRESS=localhost:7233
# The Temporal namespace this service's client will operate in.
TEMPORAL_NAMESPACE=default

# -----------------------------------------------------------------------------
# DISTRIBUTED CACHING (Redis)
# -----------------------------------------------------------------------------
# The connection URL for the Redis cluster, used for caching GraphQL queries and sessions.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# APOLLO FEDERATION - SUBGRAPH ENDPOINTS
# -----------------------------------------------------------------------------
# The URLs for the downstream GraphQL microservices (subgraphs) that this gateway composes.
USERS_SERVICE_URL=http://localhost:4001/graphql
ACCOUNTS_SERVICE_URL=http://localhost:4002/graphql
TRANSACTIONS_SERVICE_URL=http://localhost:4003/graphql
AI_AGENT_SERVICE_URL=http://localhost:4004/graphql
PLAID_INTEGRATION_SERVICE_URL=http://localhost:4005/graphql

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical service name for this gateway, used for identifying traces, metrics, and logs.
OTEL_SERVICE_NAME=api-gateway
# The HTTP endpoint of the OpenTelemetry Collector where trace data will be sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# The port on which this service will expose its own Prometheus metrics.
PROMETHEUS_PORT=9464
