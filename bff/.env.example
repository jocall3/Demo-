# .env.example for the API Gateway

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the application is running in (e.g., development, production)
NODE_ENV=development

# The port the API Gateway will listen on.
PORT=4000


# -----------------------------------------------------------------------------
# CORS & CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
# The URL of the frontend client application for CORS configuration.
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# --- OIDC Configuration (replaces legacy JWT_SECRET) ---
# The base URL of the OIDC-compliant Identity Provider (e.g., Auth0, Keycloak).
# This is the issuer of the JWTs.
AUTH_ISSUER_URL=https://your-auth-provider.com/
# The audience identifier for the API, used to validate the 'aud' claim in JWTs.
AUTH_AUDIENCE=https://api.demobank.com

# --- Inter-Service Communication ---
# A shared secret for authenticating requests from the gateway to its subgraphs.
# In a full production system, this would be replaced by a token exchange flow.
# This secret should be managed via the secrets management system.
SUBGRAPH_API_KEY=your-secret-key-for-subgraph-communication


# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# The address of the Vault server.
VAULT_ADDR=http://localhost:8200
# The AppRole Role ID for this service to authenticate with Vault.
VAULT_ROLE_ID=
# In local development, a root token can be used for simplicity.
# VAULT_TOKEN=


# -----------------------------------------------------------------------------
# APOLLO FEDERATION - SUBGRAPH ENDPOINTS
# -----------------------------------------------------------------------------
# The URLs for the downstream GraphQL microservices (subgraphs) that this gateway composes.
USERS_SERVICE_URL=http://localhost:4001/graphql
ACCOUNTS_SERVICE_URL=http://localhost:4002/graphql
TRANSACTIONS_SERVICE_URL=http://localhost:4003/graphql
AI_AGENT_SERVICE_URL=http://localhost:4004/graphql
PLAID_INTEGRATION_SERVICE_URL=http://localhost:4005/graphql


# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical service name for this gateway, used for identifying traces, metrics, and logs.
OTEL_SERVICE_NAME=api-gateway

# The HTTP endpoint of the OpenTelemetry Collector where trace data will be sent.
# Default for OTLP/HTTP is port 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# The port on which this service will expose its own Prometheus metrics.
PROMETHEUS_PORT=9464


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Recommended values: 'debug' for development, 'info' for production.
LOG_LEVEL=info
