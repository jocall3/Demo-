# .env.example for the API Gateway (formerly BFF) service
# This file serves as a template for the environment variables required to run the gateway.
# Copy this file to .env and fill in the values for your environment.

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the application is running in (e.g., development, production, test)
NODE_ENV=development

# The port the API Gateway will listen on.
PORT=3001

# -----------------------------------------------------------------------------
# GATEWAY & CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
# The URL of the frontend client application. This is used for CORS configuration
# to allow requests from the browser.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# A strong, random secret key for signing and verifying JSON Web Tokens (JWTs).
# This is used by the gateway to authenticate requests from the client.
# In production, use a long, randomly generated string.
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# APOLLO FEDERATION - SUBGRAPH ENDPOINTS
# -----------------------------------------------------------------------------
# The URLs for the downstream GraphQL microservices (subgraphs) that this gateway will compose.
# In a local Docker environment, these would be the service names (e.g., http://banking-service:4001/graphql).
BANKING_SUBGRAPH_URL=http://localhost:4001/graphql
GENAI_SUBGRAPH_URL=http://localhost:4002/graphql
# Add other subgraph URLs here as they are created:
# USERS_SUBGRAPH_URL=http://localhost:4003/graphql

# An optional shared API key for securing communication between the gateway and its subgraphs.
# The gateway would send this in a header, and each subgraph would validate it.
SUBGRAPH_API_KEY=

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical service name for this gateway, used for identifying traces, metrics, and logs.
OTEL_SERVICE_NAME=api-gateway

# The HTTP endpoint of the OpenTelemetry Collector where telemetry data will be sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Recommended values: 'debug' for development, 'info' for production.
LOG_LEVEL=info
