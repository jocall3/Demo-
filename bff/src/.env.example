# Application Configuration
PORT=3001

# CORS Configuration
# A comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# Example: http://localhost:5173,https://your-production-frontend.com
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
# A strong, random secret key for signing and verifying JSON Web Tokens.
JWT_SECRET=a-very-strong-and-long-secret-for-jwt-that-is-at-least-32-characters
JWT_EXPIRES_IN=1d

# Google Generative AI
# Your API key for accessing Google GenAI services like Gemini.
# This key will be managed by the BFF and not exposed to the client.
GOOGLE_GENAI_API_KEY=

# Plaid Integration (Simulated)
# Client ID and Secret for the Plaid API. Use sandbox keys for development.
PLAID_CLIENT_ID=
PLAID_SECRET=
# The environment to use: 'sandbox', 'development', or 'production'
PLAID_ENV=sandbox

# Stripe Integration (Simulated)
# Your secret key for the Stripe API. Use test keys for development.
STRIPE_SECRET_KEY=

# Logging Configuration
# Controls the verbosity of application logs. Can be 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=debug
