{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 20,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "row",
      "title": "Business KPIs"
    },
    {
      "id": 21,
      "title": "Link Tokens Created (total)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(plaid_link_tokens_created_total{job=\"$job\", service_name=\"$service_name\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Items Linked (total)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(plaid_items_created_total{job=\"$job\", service_name=\"$service_name\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Transactions Synced / min",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(plaid_transactions_synced_total{job=\"$job\", service_name=\"$service_name\"}[1m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "Plaid API Error Rate",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(rate(plaid_api_calls_total{job=\"$job\", service_name=\"$service_name\", status=\"error\"}[5m])) / sum(rate(plaid_api_calls_total{job=\"$job\", service_name=\"$service_name\"}[5m]))) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "type": "row",
      "title": "Plaid API Performance"
    },
    {
      "id": 26,
      "title": "Plaid API Call Rate by Operation",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(plaid_api_calls_total{job=\"$job\", service_name=\"$service_name\", operation=~\"$plaid_operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 27,
      "title": "Plaid API P99 Latency by Operation",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(plaid_api_call_duration_seconds_bucket{job=\"$job\", service_name=\"$service_name\", operation=~\"$plaid_operation\"}[$__rate_interval])) by (le, operation))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "type": "row",
      "title": "Service Health (RED Metrics)"
    },
    {
      "id": 2,
      "title": "Request Rate",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_seconds_count{job=\"$job\", service_name=\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_duration_seconds_count{job=\"$job\", service_name=\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\", otel_status_code=\"ERROR\"}[$__rate_interval])) / sum(rate(http_server_duration_seconds_count{job=\"$job\", service_name=\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\"}[$__rate_interval]))) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "P99 Latency",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_seconds_bucket{job=\"$job\", service_name=\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\"}[$__rate_interval])) by (le))",
          "refId": "A"
        }
      ]
    },
     {
      "id": 12,
      "title": "Active Requests",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum(http_server_active_requests{job=\"$job\", service_name=\"$service_name\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "type": "row",
      "title": "GraphQL Performance Details"
    },
    {
      "id": 3,
      "title": "Request Rate by Operation",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (graphql_operation_name) (rate(http_server_duration_seconds_count{job=\"$job\", service_name=\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\"}[$__rate_interval]))",
          "legendFormat": "{{graphql_operation_name}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "opentelemetry",
    "microservice",
    "plaid"
  ],
  "templating": {
    "list": [
      {
        "hide": 2,
        "name": "service_name",
        "query": "plaid-integration-service",
        "type": "constant"
      },
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(up{service_name=\"$service_name\"}, job)",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "job",
        "options": [],
        "query": {
          "query": "label_values(up{service_name=\"$service_name\"}, job)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      },
      {
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(http_server_duration_seconds_count{job=\"$job\", service_name=\"$service_name\"}, graphql_operation_name)",
        "description": "Select GraphQL operations to display",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "graphql_operation_name",
        "options": [],
        "query": {
          "query": "label_values(http_server_duration_seconds_count{job=\"$job\", service_name=\"$service_name\"}, graphql_operation_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      },
      {
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(plaid_api_calls_total{job=\"$job\", service_name=\"$service_name\"}, operation)",
        "description": "Select Plaid API operations to display",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "plaid_operation",
        "options": [],
        "query": {
          "query": "label_values(plaid_api_calls_total{job=\"$job\", service_name=\"$service_name\"}, operation)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Plaid Integration Service",
  "uid": "plaid-integration-service-dashboard",
  "version": 1
}