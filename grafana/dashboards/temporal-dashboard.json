              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(temporal_workflow_failed_total{job=~\"$job\", namespace=~\"$namespace\", task_queue=~\"$task_queue\", workflow_type=~\"$workflow_type\"}[$__rate_interval]))",
          "refId": "A"
        }
