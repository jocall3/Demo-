      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(temporal_workflow_endtoend_latency_seconds_bucket{job=~\"$job\", namespace=~\"$namespace\", task_queue=~\"$task_queue\", workflow_type=~\"$workflow_type\"}[$__rate_interval])) by (le, workflow_type))",
          "legendFormat": "p95 {{workflow_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "gridPos": {
        "h": 1,
