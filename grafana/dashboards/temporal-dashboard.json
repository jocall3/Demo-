    {
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "type": "row",
      "title": "Workflow Performance"
    },
    {
      "id": 12,
      "title": "Workflow Execution Rate by Type",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (workflow_type) (rate(temporal_workflow_completed_total{job=~\"$job\", namespace=~\"$namespace\", task_queue=~\"$task_queue\", workflow_type=~\"$workflow_type\"}[$__rate_interval]))",
          "legendFormat": "{{workflow_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Workflow E2E Latency (p95)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
