{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "row",
      "title": "Service Health Overview (RED Metrics)"
    },
    {
      "id": 2,
      "title": "Request Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_duration_seconds_count{job=~\"$job\", service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(http_server_duration_seconds_count{job=~\"$job\", service_name=~\"$service_name\", otel_status_code=\"ERROR\"}[$__rate_interval])) / sum(rate(http_server_duration_seconds_count{job=~\"$job\", service_name=~\"$service_name\"}[$__rate_interval]))) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_seconds_bucket{job=~\"$job\", service_name=~\"$service_name\"}[$__rate_interval])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(http_server_active_requests{job=~\"$job\", service_name=~\"$service_name\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "type": "row",
      "title": "Business Metrics"
    },
    {
      "id": 7,
      "title": "Transactions Ingestion Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "txns/sec"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(transactions_ingested_total{job=~\"$job\", service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Transactions by Category",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "displayLabels": ["name", "percent"],
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (category) (increase(transactions_ingested_total{job=~\"$job\", service_name=~\"$service_name\"}[$__range]))",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "New Transactions Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(transactions_ingested_total{job=~\"$job\", service_name=~\"$service_name\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "type": "row",
      "title": "Performance & System"
    },
    {
        "id": 11,
        "title": "Request Throughput by Operation",
        "type": "timeseries",
        "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
        },
        "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 15
        },
        "targets": [{
            "expr": "sum by (graphql_operation_name) (rate(http_server_duration_seconds_count{job=~\"$job\", service_name=~\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\"}[$__rate_interval]))",
            "legendFormat": "{{graphql_operation_name}}",
            "refId": "A"
        }],
        "fieldConfig": {
            "defaults": {
                "unit": "reqps"
            }
        }
    },
    {
        "id": 12,
        "title": "Request Latency by Operation (p95)",
        "type": "timeseries",
        "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
        },
        "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 15
        },
        "targets": [{
            "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_seconds_bucket{job=~\"$job\", service_name=~\"$service_name\", graphql_operation_name=~\"$graphql_operation_name\"}[$__rate_interval])) by (le, graphql_operation_name))",
            "legendFormat": "p95 {{graphql_operation_name}}",
            "refId": "A"
        }],
        "fieldConfig": {
            "defaults": {
                "unit": "s"
            }
        }
    },
    {
        "id": 13,
        "title": "CPU Usage",
        "type": "timeseries",
        "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
        },
        "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 23
        },
        "targets": [{
            "expr": "sum(rate(process_cpu_seconds_total{job=~\"$job\", service_name=~\"$service_name\"}[5m])) by (instance)",
            "legendFormat": "{{instance}}",
            "refId": "A"
        }],
        "fieldConfig": {
            "defaults": {
                "unit": "percent"
            }
        }
    },
    {
        "id": 14,
        "title": "Memory Usage",
        "type": "timeseries",
        "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
        },
        "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 23
        },
        "targets": [{
            "expr": "sum(process_resident_memory_bytes{job=~\"$job\", service_name=~\"$service_name\"}) by (instance)",
            "legendFormat": "{{instance}}",
            "refId": "A"
        }],
        "fieldConfig": {
            "defaults": {
                "unit": "bytes"
            }
        }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "opentelemetry",
    "microservice",
    "transactions"
  ],
  "templating": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up, job)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "job",
        "options": [],
        "query": "label_values(up, job)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      },
      {
        "hide": 2,
        "name": "service_name",
        "query": "transactions-service",
        "type": "constant"
      },
      {
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(http_server_duration_seconds_count{job=~\"$job\", service_name=~\"$service_name\"}, graphql_operation_name)",
        "description": "Select GraphQL operations to display",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "graphql_operation_name",
        "options": [],
        "query": "label_values(http_server_duration_seconds_count{job=~\"$job\", service_name=~\"$service_name\"}, graphql_operation_name)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Transactions Service",
  "uid": "transactions-service-dashboard",
  "version": 1
}