{
  "realm": "demobank",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default role for authenticated end-users."
      },
      {
        "name": "admin",
        "description": "Administrator with elevated privileges."
      }
    ]
  },
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "user"
  ],
  "clients": [
    {
      "clientId": "demobank-frontend",
      "name": "DemoBank Frontend SPA",
      "description": "The public client representing the single-page application.",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://demobank.example.com/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://demobank.example.com"
      ],
      "protocolMappers": [
        {
          "name": "audience-for-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api-gateway",
      "name": "API Gateway",
      "description": "Confidential client that performs token exchange on behalf of users.",
      "secret": "${API_GATEWAY_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "authorizationServicesEnabled": true,
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "policies": [
          {
            "name": "API Gateway Service Account Policy",
            "type": "js",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "description": "Grants permission only to the service account of the API Gateway client itself.",
            "config": {
              "code": "var context = $evaluation.getContext();\nvar identity = context.getIdentity();\n\n// Grant if the requester is the service account of this client (api-gateway)\nif (identity.getRealm().getClientById('api-gateway').getServiceAccountUser().getId() === identity.id) {\n    $evaluation.grant();\n}"
            }
          }
        ],
        "scopes": [
          {
            "name": "urn:ietf:params:oauth:grant-type:token-exchange"
          }
        ],
        "permissions": [
          {
            "name": "Token Exchange Permission",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "description": "Allows the API Gateway to perform the OAuth 2.0 Token Exchange grant.",
            "config": {
              "scopes": "[\"urn:ietf:params:oauth:grant-type:token-exchange\"]",
              "applyPolicies": "[\"API Gateway Service Account Policy\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "accounts-service",
      "name": "Accounts Service",
      "description": "Resource server for the Accounts microservice. Acts as an audience in token exchange.",
      "secret": "${ACCOUNTS_SERVICE_CLIENT_SECRET}",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "transactions-service",
      "name": "Transactions Service",
      "description": "Resource server for the Transactions microservice. Acts as an audience in token exchange.",
      "secret": "${TRANSACTIONS_SERVICE_CLIENT_SECRET}",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "user-service",
      "name": "User Service",
      "description": "Resource server for the User microservice. Acts as an audience in token exchange.",
      "secret": "${USER_SERVICE_CLIENT_SECRET}",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "ai-agent-service",
      "name": "AI Agent Service",
      "description": "Resource server for the AI Agent microservice. Acts as an audience in token exchange.",
      "secret": "${AI_AGENT_SERVICE_CLIENT_SECRET}",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "plaid-integration-service",
      "name": "Plaid Integration Service",
      "description": "Resource server for the Plaid Integration microservice. Acts as an audience in token exchange.",
      "secret": "${PLAID_INTEGRATION_SERVICE_CLIENT_SECRET}",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "the_visionary",
      "enabled": true,
      "emailVerified": true,
      "firstName": "The",
      "lastName": "Visionary",
      "email": "visionary@demobank.com",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ]
    }
  ]
}