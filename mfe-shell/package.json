    "eslint-plugin-react-refresh": "^0.4.7",
    "external-remotes-plugin": "^1.0.0",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.2",
    "serve": "^14.2.3",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "webpack": "^5.92.0",
