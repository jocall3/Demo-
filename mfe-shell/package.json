{
  "name": "mfe-shell",
  "version": "1.0.0",
  "description": "The shell application for the Demo Bank micro-frontend architecture, responsible for layout, routing, and orchestrating remote MFEs.",
  "private": true,
  "scripts": {
    "start": "webpack serve --config webpack.config.js",
    "build": "webpack --mode production --config webpack.config.js",
    "serve": "serve dist -p 8080",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"
  },
  "dependencies": {
    "@apollo/client": "^3.10.8",
    "@auth0/auth0-react": "^2.2.4",
    "@demobank/ui-components": "1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.38.0",
    "@opentelemetry/context-zone": "^1.25.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/instrumentation": "^0.52.0",
    "@opentelemetry/instrumentation-document-load": "^0.38.0",
    "@opentelemetry/instrumentation-fetch": "^0.52.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.42.0",
    "@opentelemetry/propagator-b3": "^1.25.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-trace-web": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@reduxjs/toolkit": "^2.2.6",
    "@tanstack/react-query": "^5.51.1",
    "graphql": "^16.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
