{
  "name": "demobank-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "The monorepo for the Demo Bank next-generation financial platform, encompassing all microservices, micro-frontends, and shared libraries.",
  "author": "Elite AI Implementation Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "api-gateway",
    "bff",
    "mfe-*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start:dev": "npm run start:dev --workspaces --if-present",
    "start:prod": "npm run start:prod --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  }
}
