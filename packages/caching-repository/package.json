{
  "name": "@demobank/caching-repository",
  "version": "1.0.0",
  "description": "A generic caching repository implementing a multi-tier (L1/L2) read-through/write-through pattern for Demo Bank microservices.",
  "author": "Elite AI Implementation Team",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint \"src/**/*.ts*\" --fix",
    "clean": "rm -rf .turbo dist node_modules"
  },
  "dependencies": {
    "cache-manager-redis-store": "^3.0.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "cache-manager": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^12.1.2",
    "@types/cache-manager": "^4.0.6",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cache-manager": "^5.6.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.0.2",
    "typescript": "^5.1.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
