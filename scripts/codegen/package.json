{
  "name": "@demobank/codegen",
  "version": "1.0.0",
  "description": "Polyglot code generation pipeline for the Demo Bank Domain Modeling Language (DML). Consumes DML definitions to generate backend classes, frontend types, GraphQL schemas, Protobufs, and database migrations.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Elite AI Implementation Team",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "generate": "ts-node src/index.ts",
    "generate:all": "npm run generate -- --all",
    "generate:backend": "npm run generate -- --target=backend-types",
    "generate:frontend": "npm run generate -- --target=frontend-types",
    "generate:graphql": "npm run generate -- --target=graphql",
    "generate:proto": "npm run generate -- --target=proto",
    "generate:db": "npm run generate -- --target=db-migrations",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "change-case": "^4.1.2",
    "fs-extra": "^11.2.0",
    "graphql": "^16.8.1",
    "handlebars": "^4.7.8",
    "prettier": "^3.3.2",
    "yaml": "^2.4.5",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.12",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
