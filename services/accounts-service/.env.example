# .env.example for Accounts Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on for GraphQL requests.
PORT=4002

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL for Read Model Projections)
# -----------------------------------------------------------------------------
# NOTE: In a Vault-integrated environment, the full DATABASE_URL is NOT set here.
# The service constructs it at runtime using dynamic credentials fetched from Vault.
# These variables might be used as fallbacks for local development without Vault.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=accounts_read_db
DB_PASSWORD=postgres # For local dev only

# -----------------------------------------------------------------------------
# MESSAGE BUS / EVENT STORE (Kafka)
# -----------------------------------------------------------------------------
# Comma-separated list of Kafka broker URLs.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this client instance when connecting to Kafka.
KAFKA_CLIENT_ID=accounts-service
# The consumer group ID for this service.
KAFKA_CONSUMER_GROUP_ID=accounts-consumer

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (OIDC)
# -----------------------------------------------------------------------------
# The issuer URL of the OpenID Connect (OIDC) provider (e.g., Keycloak, Auth0).
# The service fetches the JWKS from this URL to validate incoming JWTs.
OIDC_ISSUER_URL=http://localhost:8180/realms/demobank
# The 'audience' claim value that this service will expect in incoming JWTs.
# This ensures that tokens intended for other services are rejected.
OIDC_AUDIENCE=accounts-service

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# The address of the Vault server.
VAULT_ADDR=http://localhost:8200
# AppRole credentials for this service to authenticate with Vault.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# The path in Vault where this service's static secrets are stored.
VAULT_SECRETS_PATH=secret/data/accounts-service
# The path in Vault for generating dynamic database credentials.
VAULT_DB_CREDS_PATH=database/creds/accounts-db-role

# -----------------------------------------------------------------------------
# DISTRIBUTED CACHING (Redis)
# -----------------------------------------------------------------------------
# Connection URL for the Redis cluster, used for caching read-model entities.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical name of the service for tracing and metrics.
OTEL_SERVICE_NAME=accounts-service
# The HTTP endpoint of the OpenTelemetry Collector where telemetry data will be sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The port on which this service will expose its Prometheus metrics endpoint.
# This should be unique for each service.
PROMETHEUS_PORT=9466

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs ('trace', 'debug', 'info', 'warn', 'error').
LOG_LEVEL=info
