# .env.example for Accounts Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on.
PORT=4002

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# These variables connect to the service's dedicated database.
# In a production environment with Vault, these would be populated dynamically.
ACCOUNTS_DB_HOST=localhost
ACCOUNTS_DB_PORT=5432
ACCOUNTS_DB_USER=postgres
ACCOUNTS_DB_PASS=postgres
ACCOUNTS_DB_NAME=accounts_db

# -----------------------------------------------------------------------------
# MESSAGE BUS CONFIGURATION (Kafka)
# -----------------------------------------------------------------------------
# Comma-separated list of Kafka broker URLs for inter-service communication.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this client instance.
KAFKA_CLIENT_ID=accounts-service
# The consumer group ID for this service.
KAFKA_CONSUMER_GROUP_ID=accounts-group

# -----------------------------------------------------------------------------
# AUTHENTICATION & AUTHORIZATION (OIDC)
# -----------------------------------------------------------------------------
# As per the new security framework, the service validates OIDC tokens.
# The JWT_SECRET has been deprecated.

# The URL of the Identity Provider (e.g., Keycloak, Auth0) for fetching JWKS.
OIDC_ISSUER_URL=http://localhost:8080/realms/demobank
# The audience value that this service will accept in JWTs.
OIDC_AUDIENCE=accounts-service

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (Plaid)
# -----------------------------------------------------------------------------
# Credentials for the Plaid API.
# In production, these secrets must be managed and fetched from Vault.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# Configuration for connecting to Vault to fetch secrets at runtime.

# The address of the Vault server.
VAULT_ADDR=http://localhost:8200

# The token for authenticating with Vault. For development only.
# In production, use a more secure method like AppRole.
VAULT_TOKEN=

# The path in Vault where this service's secrets are stored.
VAULT_SECRETS_PATH=secret/data/accounts-service

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=accounts-service

# The endpoint where the OpenTelemetry collector is running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Port for the Prometheus exporter to expose metrics for scraping.
# Choose a unique port for each service.
PROMETHEUS_PORT=9466

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error', 'fatal'.
LOG_LEVEL=info
