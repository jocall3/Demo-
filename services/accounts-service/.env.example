# .env.example for Accounts Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on.
PORT=4002

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Connection string for the service's dedicated database.
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/accounts_db"
DATABASE_URL=

# -----------------------------------------------------------------------------
# MESSAGE BUS CONFIGURATION (e.g., Kafka)
# -----------------------------------------------------------------------------
# Comma-separated list of Kafka broker URLs for inter-service communication.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this client instance.
KAFKA_CLIENT_ID=accounts-service
# The consumer group ID for this service.
KAFKA_GROUP_ID=accounts-group

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# A strong, random secret for validating JWTs received from the API Gateway.
# This should be shared across all internal services that need to validate user identity.
JWT_SECRET=your-strong-jwt-secret-for-internal-communication

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=accounts-service

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Port for the Prometheus exporter to expose metrics for scraping.
# Choose a unique port for each service.
PROMETHEUS_PORT=9466

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error', 'fatal'.
LOG_LEVEL=info
