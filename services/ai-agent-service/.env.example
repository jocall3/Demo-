# .env.example for AI Agent Service

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# The environment the application is running in (e.g., development, production)
NODE_ENV=development
# The port the AI Agent service will listen on.
PORT=4004
# Controls the verbosity of application logs ('trace', 'debug', 'info', 'warn', 'error').
LOG_LEVEL=info

# =============================================================================
# SECRETS MANAGEMENT (HashiCorp Vault)
# =============================================================================
# Address of the HashiCorp Vault server.
VAULT_ADDR=http://localhost:8200
# AppRole Role ID for this service to authenticate with Vault.
VAULT_ROLE_ID=
# AppRole Secret ID for this service. For local dev, this can be static.
# In production, this should be a wrapped token or injected securely.
VAULT_SECRET_ID=
# The base path in Vault where this service's secrets are stored.
# e.g., secret/data/demobank/ai-agent-service
VAULT_KV_PATH=secret/data/demobank/ai-agent-service

# NOTE: Secrets like GOOGLE_GEMINI_API_KEY are no longer defined here.
# The service will fetch them from Vault at runtime using the credentials above.
# The path would be, for example, VAULT_KV_PATH with a key named 'google_gemini_api_key'.


# =============================================================================
# IDENTITY & AUTHENTICATION (OAuth 2.0 / OIDC)
# =============================================================================
# The issuer URL of the OpenID Connect (OIDC) provider (e.g., Keycloak, Auth0).
# The service will fetch the JWKS from this URL to validate incoming JWTs.
IDENTITY_PROVIDER_URL=http://localhost:8080/realms/demobank
# The 'audience' claim value that this service will expect in incoming JWTs.
# This ensures that tokens intended for other services are rejected.
IDENTITY_PROVIDER_AUDIENCE=ai-agent-service-api

# =============================================================================
# WORKFLOW ORCHESTRATION ENGINE (e.g., Temporal)
# =============================================================================
# The gRPC endpoint for the Temporal frontend service.
TEMPORAL_SERVER_URL=localhost:7233
# The Temporal namespace this service's workers will operate in.
TEMPORAL_NAMESPACE=default
# The name of the task queue this service's workers will poll for activities.
TEMPORAL_TASK_QUEUE=ai-agent-tasks

# =============================================================================
# MESSAGE BUS (Kafka)
# =============================================================================
# A comma-separated list of Kafka broker addresses.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this service when it connects to Kafka.
KAFKA_CLIENT_ID=ai-agent-service
# The consumer group ID for this service. All instances of this service will
# share this group ID to distribute topic partitions.
KAFKA_GROUP_ID=ai-agent-group

# =============================================================================
# OBSERVABILITY (OpenTelemetry)
# =============================================================================
# The logical name of the service for tracing and metrics.
OTEL_SERVICE_NAME=ai-agent-service
# The HTTP endpoint of the OpenTelemetry Collector where telemetry data will be sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The port on which this service will expose its Prometheus metrics endpoint.
# This should be unique for each service.
PROMETHEUS_PORT=9467
