# .env.example for AI Agent Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the application is running in (e.g., development, production)
NODE_ENV=development
# The port the AI Agent service will listen on.
PORT=4003

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Connection string for the service's dedicated database (e.g., PostgreSQL).
# This database will store agent configurations, conversation histories, etc.
DATABASE_URL=postgresql://user:password@localhost:5434/ai_agent_db?schema=public

# -----------------------------------------------------------------------------
# MESSAGE BUS (KAFKA) CONFIGURATION
# -----------------------------------------------------------------------------
# A comma-separated list of Kafka broker addresses.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this service when it connects to Kafka.
KAFKA_CLIENT_ID=ai-agent-service
# The consumer group ID for this service. All instances of this service will
# share this group ID to distribute topic partitions.
KAFKA_GROUP_ID=ai-agent-group

# -----------------------------------------------------------------------------
# EXTERNAL AI PROVIDERS
# -----------------------------------------------------------------------------
# API Key for Google Generative AI services (e.g., Gemini).
# Get from https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=

# (Optional) Add keys for other providers if the service will support them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical name of the service for tracing and metrics.
OTEL_SERVICE_NAME=ai-agent-service

# The endpoint of the OpenTelemetry Collector where telemetry data will be sent.
# The default OTLP HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port on which this service will expose its Prometheus metrics endpoint.
PROMETHEUS_PORT=9466

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Common values: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'.
LOG_LEVEL=info
