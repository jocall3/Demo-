# .env.example for Banking Service Subgraph

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on.
PORT=4001

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for the service's dedicated database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/banking_db

# -----------------------------------------------------------------------------
# EXTERNAL SERVICE API KEYS
# -----------------------------------------------------------------------------
# Plaid API Keys - Get from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# Plaid environment can be 'sandbox', 'development', or 'production'
PLAID_ENV=sandbox

# Stripe API Keys - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# A shared secret used by the API Gateway to authenticate itself to this subgraph.
# This should be a strong, random string.
SUBGRAPH_API_KEY=your-strong-subgraph-api-key

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=banking-service

# The HTTP endpoint of the OpenTelemetry Collector where telemetry data will be sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port on which this service will expose its Prometheus metrics endpoint.
# This should be unique for each service.
METRICS_PORT=9465

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=info
