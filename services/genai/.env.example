# .env.example for GenAI Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the application is running in (e.g., development, production)
NODE_ENV=development

# The port the service will listen on. This should be unique for each microservice.
PORT=4002

# Controls the verbosity of application logs ('trace', 'debug', 'info', 'warn', 'error').
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------
# API Key for Google Generative AI services (e.g., Gemini).
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# A shared secret for authenticating requests from the API Gateway to this subgraph.
# This should match the SUBGRAPH_API_KEY set in the API Gateway's environment.
SUBGRAPH_API_KEY=your-secure-subgraph-api-key

# OIDC configuration for validating JWTs from the Identity Provider.
# This aligns with the new OAuth 2.0/OIDC architecture.

# The URL of the OIDC-compliant issuer (e.g., Auth0, Keycloak).
AUTH_AUTHORITY=https://demobank.us.auth0.com/

# The audience for the JWTs, which this service will validate.
AUTH_AUDIENCE=https://api.demobank.com/


# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=genai-service

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port on which this service will expose its Prometheus metrics endpoint.
# This must be unique for each service.
PROMETHEUS_PORT=9467
