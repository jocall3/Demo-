# .env.example for Metrics Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on for GraphQL requests.
# Each microservice should have a unique port.
PORT=4006
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SECURITY & SECRETS MANAGEMENT (NEW ARCHITECTURE)
# -----------------------------------------------------------------------------
# Configuration for the central Identity Provider (e.g., Keycloak, Auth0)
IDP_ISSUER_URL=http://localhost:8080/realms/demobank
IDP_TOKEN_URL=http://localhost:8080/realms/demobank/protocol/openid-connect/token

# This service's credentials for authenticating with the Identity Provider.
# The secret is fetched from Vault, not stored here.
SERVICE_CLIENT_ID=metrics-service

# Configuration for HashiCorp Vault
VAULT_ADDR=http://localhost:8200

# The path in Vault where the service can authenticate (e.g., using AppRole)
VAULT_ROLE_ID_PATH=secret/data/metrics-service/approle-id
VAULT_SECRET_ID_PATH=secret/data/metrics-service/approle-secret-id

# The path in Vault where the IDP client secret is stored.
SERVICE_CLIENT_SECRET_PATH=secret/data/metrics-service/idp-client-secret

# -----------------------------------------------------------------------------
# DOWNSTREAM SERVICES
# -----------------------------------------------------------------------------
# The URL of the Prometheus server for querying metrics data.
PROMETHEUS_URL=http://prometheus:9090

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=metrics-service

# The endpoint where the OpenTelemetry collector is running.
# This should point to the collector's OTLP HTTP receiver.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Port for the Prometheus exporter to expose this service's own metrics for scraping.
# This must be unique for each service.
METRICS_PROMETHEUS_PORT=9465
