# .env.example for the Plaid Integration Microservice
# This service handles all interactions with the Plaid API and communicates with
# other services via the event bus (Kafka).

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the service is running in (e.g., development, production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# PLAID API CONFIGURATION
# -----------------------------------------------------------------------------
# Get your Plaid API keys from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
# In production, this secret MUST be sourced from a secrets manager like HashiCorp Vault.
PLAID_SECRET=

# The Plaid environment to use: 'sandbox', 'development', or 'production'
PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Connection string for this service's dedicated database.
# This service is responsible for storing Plaid item IDs, access tokens, etc.
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5433/plaid_db"
DATABASE_URL=

# -----------------------------------------------------------------------------
# MESSAGE BUS (KAFKA)
# -----------------------------------------------------------------------------
# A comma-separated list of Kafka broker hosts.
# Example: KAFKA_BROKERS=kafka1:9092,kafka2:9092
KAFKA_BROKERS=localhost:9092

# A unique client ID for this service to identify itself to the Kafka cluster.
KAFKA_CLIENT_ID=plaid-integration-service

# The consumer group ID this service instance will belong to.
KAFKA_GROUP_ID=plaid-integration-group

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# A secret used for encrypting sensitive data like Plaid access tokens in the database.
# Generate a strong, random 32-character string. (e.g., `openssl rand -base64 32`)
# In production, this secret MUST be sourced from a secrets manager like HashiCorp Vault.
DATA_ENCRYPTION_KEY=

# The URL of the OpenID Connect (OIDC) provider. This is used to fetch the JWKS for validating tokens.
# Example: OIDC_ISSUER_URL=https://<your-identity-provider>.com/
OIDC_ISSUER_URL=

# The expected audience for the JWTs this service will validate.
OIDC_AUDIENCE=https://api.demobank.com

# --- Service-to-Service Authentication (Token Exchange) ---
# OIDC client credentials for this service, used to authenticate with the IdP for the token exchange flow.
# In production, these secrets MUST be sourced from a secrets manager like HashiCorp Vault.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=plaid-integration-service

# The endpoint where the OpenTelemetry collector is running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port on which this service will expose its Prometheus metrics endpoint.
PROMETHEUS_PORT=9467

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=info
