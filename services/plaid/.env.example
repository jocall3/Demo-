# .env.example for the Plaid Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the application is running in (e.g., development, production)
NODE_ENV=development

# The port the service's GraphQL subgraph will listen on.
# Each microservice should have a unique port.
PORT=4005

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# As per the security directive, all secrets are managed in Vault.
# The application will use these variables to authenticate with Vault at startup.

# The address of the Vault server.
VAULT_ADDR=http://127.0.0.1:8200

# The AppRole role_id for this service, used for machine-based authentication to Vault.
VAULT_ROLE_ID=

# The AppRole secret_id for this service. In production, this should be handled securely.
VAULT_SECRET_ID=

# The Vault path where this service's secrets (Plaid keys, DB credentials) are stored.
# The service will fetch secrets like PLAID_CLIENT_ID, PLAID_SECRET, and DATABASE_URL from here.
VAULT_SECRETS_PATH=secret/data/plaid-service

# -----------------------------------------------------------------------------
# IDENTITY & ACCESS MANAGEMENT (OIDC)
# -----------------------------------------------------------------------------
# The issuer URL of the OpenID Connect provider (e.g., Keycloak, Auth0).
# This is the source of truth for token validation.
OIDC_ISSUER_URL=https://identity.demobank.com/realms/main

# The client ID for this service, used for the OAuth 2.0 client credentials flow
# when this service needs to acquire its own token to call other services.
OIDC_CLIENT_ID=plaid-service

# The Vault path to this service's OIDC client secret.
VAULT_OIDC_SECRET_PATH=secret/data/oidc-clients/plaid-service

# The audience value (also known as 'aud' claim) that this service expects in incoming JWTs.
# This ensures that tokens intended for other services are not accepted.
OIDC_TOKEN_AUDIENCE=api://plaid-service

# -----------------------------------------------------------------------------
# PLAID API CONFIGURATION (Managed in Vault)
# -----------------------------------------------------------------------------
# These variables are documented here for clarity but are fetched from Vault at runtime.
#
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...
# PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# DATABASE (Managed in Vault)
# -----------------------------------------------------------------------------
# The database connection string is also fetched from Vault.
# This service requires a database to store Plaid item identifiers and encrypted access tokens.
#
# DATABASE_URL=...

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=plaid-service

# The endpoint where the OpenTelemetry collector is running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port on which this service will expose its Prometheus metrics endpoint.
# This should be unique for each service type.
PROMETHEUS_PORT=9465

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=info
