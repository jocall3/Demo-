# .env.example for Transactions Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the application is running in (e.g., development, production, test)
NODE_ENV=development

# The port the service will listen on. Each microservice should have a unique port.
PORT=4003

# -----------------------------------------------------------------------------
# DATABASE (Polyglot Persistence)
# -----------------------------------------------------------------------------
# Connection string for the service's dedicated database.
# The Transactions service might use a time-series database like TimescaleDB or InfluxDB
# for optimal performance, but a standard PostgreSQL connection string is a good example.
# Example: DATABASE_URL="postgresql://user:password@localhost:5434/transactions_db"
DATABASE_URL=

# -----------------------------------------------------------------------------
# MESSAGE BUS (e.g., Kafka)
# -----------------------------------------------------------------------------
# A comma-separated list of message broker hosts to connect to.
KAFKA_BROKERS=kafka:9092

# A unique identifier for this client instance when connecting to the message bus.
KAFKA_CLIENT_ID=transactions-service

# The consumer group ID this service will belong to. All instances of this service
# should share the same group ID to distribute topic partitions.
KAFKA_GROUP_ID=transactions-group

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms (e.g., Jaeger, Prometheus).
OTEL_SERVICE_NAME=transactions-service

# The endpoint where the OpenTelemetry collector is running.
# This is typically a shared collector for all services in the cluster.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# The port on which the Prometheus metrics endpoint will be exposed by this service.
# This must be unique for each service if running on the same host without containers.
METRICS_PROMETHEUS_PORT=9464

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=debug
