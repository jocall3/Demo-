# .env.example for Transactions Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on. Each microservice should have a unique port.
PORT=4003

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Database credentials. In a production environment, these should be populated
# at runtime from a secrets management system like HashiCorp Vault.
DB_HOST=localhost
DB_PORT=5434
DB_USER=user
DB_PASSWORD=password
DB_NAME=transactions_db

# -----------------------------------------------------------------------------
# MESSAGE BUS (Kafka)
# -----------------------------------------------------------------------------
# A comma-separated list of Kafka broker hosts to connect to.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this client instance when connecting to Kafka.
KAFKA_CLIENT_ID=transactions-service
# The consumer group ID this service instance will belong to.
KAFKA_GROUP_ID=transactions-group

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (OIDC)
# -----------------------------------------------------------------------------
# The URL of the OpenID Connect (OIDC) provider (e.g., Keycloak, Auth0).
OIDC_ISSUER_URL=http://localhost:8080/realms/demobank
# The audience value that will be checked in the JWT access token. This should be
# a unique identifier for this service.
OIDC_AUDIENCE=transactions-service
# Client ID for this service to authenticate with the OIDC provider for token exchange.
OIDC_CLIENT_ID=transactions-service-client
# Client secret for this service (this is a secret and should be managed by Vault).
OIDC_CLIENT_SECRET=your-oidc-client-secret

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (HashiCorp Vault)
# -----------------------------------------------------------------------------
# The address of the HashiCorp Vault server.
VAULT_ADDR=http://localhost:8200
# The AppRole Role ID for this service to authenticate with Vault.
VAULT_ROLE_ID=
# Path in Vault where this service can fetch its secrets (e.g., database credentials, OIDC secret).
VAULT_SECRETS_PATH=secret/data/transactions-service

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The logical name of the service for tracing and metrics.
OTEL_SERVICE_NAME=transactions-service
# The HTTP endpoint of the OpenTelemetry Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# The port on which this service will expose its Prometheus metrics endpoint.
METRICS_PROMETHEUS_PORT=9464

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs ('trace', 'debug', 'info', 'warn', 'error').
LOG_LEVEL=debug
