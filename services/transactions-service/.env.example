# .env.example for Transactions Service (Re-architected)
# This service now adheres to CQRS, Event Sourcing, and uses Vault for secrets management and Temporal for workflows.

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# The environment the application is running in (e.g., development, production)
NODE_ENV=development
# The port the service's GraphQL subgraph will listen on.
PORT=4003
# Controls the verbosity of application logs ('trace', 'debug', 'info', 'warn', 'error').
LOG_LEVEL=info

# =============================================================================
# SECRETS MANAGEMENT (HashiCorp Vault)
# =============================================================================
# As per the security directive, all secrets are managed in Vault.
# The application will use these variables to authenticate with Vault at startup.

# The address of the Vault server.
VAULT_ADDR=http://localhost:8200

# The AppRole role_id for this service, used for machine-based authentication to Vault.
VAULT_ROLE_ID=

# The AppRole secret_id for this service. In production, this should be a wrapped token or injected securely.
VAULT_SECRET_ID=

# The Vault path where this service can generate its dynamic database credentials.
VAULT_DB_CREDS_PATH=database/creds/transactions-service-role

# =============================================================================
# DATABASE (Configuration via Vault)
# =============================================================================
# The DATABASE_URL is no longer configured here. The service will fetch dynamic
# database credentials from Vault using the VAULT_DB_CREDS_PATH at startup.
# The read model for transactions will be stored in a NoSQL database.
MONGODB_URI=
MONGODB_DATABASE=transactions_read_db

# =============================================================================
# EVENT STORE / MESSAGE BUS (Kafka)
# =============================================================================
# A comma-separated list of Kafka broker hosts to connect to.
KAFKA_BROKERS=localhost:9092
# The consumer group ID this service instance will belong to for consuming events.
KAFKA_GROUP_ID=transactions-service-group

# =============================================================================
# WORKFLOW ORCHESTRATION (Temporal)
# =============================================================================
# The gRPC endpoint for the Temporal frontend service.
TEMPORAL_ADDRESS=localhost:7233
# The Temporal namespace to use for workflows and activities.
TEMPORAL_NAMESPACE=default
# The task queue this service's workers will listen on for transaction-related tasks.
TEMPORAL_TASK_QUEUE=transactions-task-queue

# =============================================================================
# SECURITY & AUTHENTICATION (OIDC)
# =============================================================================
# The URL of the OpenID Connect (OIDC) provider (e.g., Keycloak, Auth0).
# This is used to fetch the JWKS for validating incoming JWTs.
OIDC_ISSUER_URL=http://localhost:8080/realms/demobank

# The 'audience' claim value that this service will expect in incoming JWTs.
# This ensures that tokens intended for other services are rejected.
OIDC_AUDIENCE=transactions-service

# =============================================================================
# DISTRIBUTED CACHING (Redis)
# =============================================================================
# The connection URL for the Redis cluster.
REDIS_URL=redis://localhost:6379

# =============================================================================
# OBSERVABILITY (OpenTelemetry)
# =============================================================================
# The logical name of the service for tracing and metrics.
OTEL_SERVICE_NAME=transactions-service

# The HTTP endpoint of the OpenTelemetry Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port on which this service will expose its Prometheus metrics endpoint.
PROMETHEUS_PORT=9468
