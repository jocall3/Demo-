# .env.example for User Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
# The port the service will listen on. Each microservice should have a unique port.
PORT=4001

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection details for the dedicated User Service database.
# In production, these will be fetched from a secrets manager like Vault.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=user_db

# -----------------------------------------------------------------------------
# MESSAGE BUS (Kafka)
# -----------------------------------------------------------------------------
# Comma-separated list of Kafka broker host:port pairs.
KAFKA_BROKERS=localhost:9092
# A unique identifier for this client instance.
KAFKA_CLIENT_ID=user-service
# The consumer group ID this service will belong to.
KAFKA_GROUP_ID=user-service-group

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (OAuth 2.0 / OIDC)
# -----------------------------------------------------------------------------
# The base URL of the Identity Provider (e.g., Keycloak, Auth0).
AUTH_SERVER_URL=http://localhost:8080/realms/demobank
# The URI of the JWKS endpoint for validating token signatures.
JWT_JWKS_URI=http://localhost:8080/realms/demobank/protocol/openid-connect/certs
# The expected audience claim in the JWT. This service will reject tokens not intended for it.
JWT_AUDIENCE=user-service
# The expected issuer claim in the JWT.
JWT_ISSUER=http://localhost:8080/realms/demobank
# A shared secret API key for authenticating requests from internal gateways (e.g., Apollo Gateway).
SUBGRAPH_API_KEY=your-strong-and-shared-subgraph-api-key

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT (Vault Configuration)
# -----------------------------------------------------------------------------
# These variables configure the connection to HashiCorp Vault.
# The database credentials above should be fetched from Vault at runtime, not set here in production.
VAULT_ADDR=http://localhost:8200
# For local dev; use AppRole, JWT/OIDC, or Kubernetes auth in production.
VAULT_TOKEN=
# The path in Vault where dynamic database credentials for this service can be generated.
VAULT_DB_CREDS_PATH=database/creds/user-service-role

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=user-service

# The endpoint where the OpenTelemetry collector is running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# The port on which the Prometheus metrics endpoint will be exposed.
PROMETHEUS_PORT=9465

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=info
