# .env.example for User Service

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The environment the service is running in (e.g., development, production)
NODE_ENV=development

# The port the service will listen on.
PORT=4010


# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for the dedicated User Service database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/user_db


# -----------------------------------------------------------------------------
# MESSAGE BUS (Kafka)
# -----------------------------------------------------------------------------
# Comma-separated list of Kafka broker host:port pairs.
KAFKA_BROKERS=localhost:9092

# A unique identifier for this client instance.
KAFKA_CLIENT_ID=user-service

# The consumer group ID this service will belong to.
KAFKA_GROUP_ID=user-service-group


# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# A strong, random secret key for validating JWTs received from the API Gateway.
# This should match the secret used by the gateway to sign the tokens.
JWT_SECRET=a-very-strong-and-long-secret-for-jwt-that-is-at-least-32-characters


# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
# The name of this service, used to identify it in observability platforms.
OTEL_SERVICE_NAME=user-service

# The endpoint where the OpenTelemetry collector is running.
# The default OTLP HTTP port is 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port for the Prometheus metrics endpoint exposed by this service.
METRICS_PROMETHEUS_PORT=9464


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Controls the verbosity of application logs.
# Can be 'trace', 'debug', 'info', 'warn', 'error'.
LOG_LEVEL=info
